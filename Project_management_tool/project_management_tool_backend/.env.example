# Django Settings
SECRET_KEY=your-secure-secret-key-goes-here
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL/MySQL)
# Example: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://cadence_user:cadence_pass@localhost:5432/cadence_db

# WebSockets Configuration (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# CORS Configuration
# Set the frontend URL that is allowed to make requests to this backend
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
